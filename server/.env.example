PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/foodiehub
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
DELIVERY_FEE=39
FREE_DELIVERY_THRESHOLD=500

# Used only by the explicit create-admin command. Never use public registration for admin access.
ADMIN_NAME=FoodieHub Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-strong-password
ADMIN_PHONE=+1-555-0100
